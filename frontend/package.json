{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
		"lint": "biome check src && pnpm run lint:e2e",
		"lint:e2e": "biome check $(git ls-files 'playwright.config.ts' 'e2e/*.ts' 'e2e/**/*.ts')",
		"lint:fix": "biome check --write src && pnpm run lint:e2e:fix",
		"lint:e2e:fix": "biome check --write $(git ls-files 'playwright.config.ts' 'e2e/*.ts' 'e2e/**/*.ts')",
		"format": "biome format --write src && pnpm run format:e2e",
		"format:e2e": "biome format --write $(git ls-files 'playwright.config.ts' 'e2e/*.ts' 'e2e/**/*.ts')",
		"format:check": "biome format src && pnpm run format:e2e:check",
		"format:e2e:check": "biome format $(git ls-files 'playwright.config.ts' 'e2e/*.ts' 'e2e/**/*.ts')",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"preview": "vite preview",
		"generate:api": "../scripts/generate-api-types.sh",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@paper-design/shaders-react": "0.0.77",
		"@phosphor-icons/react": "2.1.10",
		"@tanstack/react-query": "5.101.2",
		"@tanstack/react-table": "8.21.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"input-otp": "1.4.2",
		"motion": "12.42.0",
		"react": "19.2.7",
		"react-day-picker": "10.0.1",
		"react-dom": "19.2.7",
		"react-router": "8.0.1",
		"sonner": "2.0.7",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@biomejs/biome": "2.5.1",
		"@playwright/test": "1.61.1",
		"@tailwindcss/vite": "4.3.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "26.0.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"jsdom": "29.1.1",
		"msw": "^2.4.9",
		"tailwindcss": "4.3.1",
		"typescript": "7.0.2",
		"vite": "8.1.0",
		"vitest": "4.1.9"
	}
}
