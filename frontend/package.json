{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "node node_modules/typescript-7/bin/tsc -b && vite build && node scripts/check-bundle-size.mjs",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"format": "biome format --write src",
		"format:check": "biome format src",
		"typecheck": "node node_modules/typescript-7/bin/tsc -b --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"preview": "vite preview",
		"generate:api": "../scripts/generate-api-types.sh"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@tanstack/react-query": "5.101.2",
		"@tanstack/react-table": "8.21.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.21.0",
		"motion": "12.42.0",
		"react": "19.2.7",
		"react-day-picker": "10.0.1",
		"react-dom": "19.2.7",
		"react-router": "8.0.1",
		"recharts": "3.9.0",
		"sonner": "2.0.7",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@tailwindcss/vite": "4.3.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "26.0.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"jsdom": "29.1.1",
		"openapi-typescript": "7.13.0",
		"tailwindcss": "4.3.1",
		"typescript": "npm:@typescript/typescript6@6.0.1",
		"typescript-7": "npm:typescript@7.0.1-rc",
		"vite": "8.1.0",
		"vitest": "4.1.9"
	}
}
