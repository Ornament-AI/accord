# Accord deploy environment template (copy to deploy/.env and fill in).
# Adapted from Atlas deploy/.env.example — ADR 0003 app settings keep their
# exact names (no ACCORD_ prefix). Ops-only vars use ACCORD_*.
#
# Host layout choice: secrets and deploy state live under /opt/accord/
# (renamed from Atlas /opt/atlas/). Adjust if your VM layout differs.

# GitHub username that owns the GHCR_TOKEN PAT
GHCR_USERNAME=

# GitHub PAT (read:packages scope) for pulling images
GHCR_TOKEN=

# --- Ops-level (compose/deploy only; ACCORD_ prefix) -------------------------

# PostgreSQL password for the compose Postgres role. The same literal is
# embedded in default DATABASE_URL / MIGRATIONS_DATABASE_URL values, so use only
# URL-unreserved characters: letters, digits, -, ., _, and ~.
ACCORD_DB_PASSWORD=

# Optional overrides for the compose Postgres role (defaults: accord / accord).
ACCORD_DB_USER=accord
ACCORD_DB_NAME=accord

# Docker image tag. Production should pin the matching immutable sha-<full-git-sha>
# tag published for both images. `latest` is a moving fallback.
ACCORD_TAG=latest

# Optional: deploy checkout directory on the VM (for future deploy-accord tooling).
ACCORD_DEPLOY_DIR=/opt/accord/deploy

# --- ADR 0003 application settings (exact names; backend reads these) -------

# Runtime API role DSN (NOSUPERUSER, NOBYPASSRLS). Required in production.
# Leave empty to use the compose default built from ACCORD_DB_*.
DATABASE_URL=

# Migration-owner role DSN (BYPASSRLS / table owner). Required in production.
MIGRATIONS_DATABASE_URL=

# WorkOS (required in production; ADR 0002/0003).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://127.0.0.1:8082/api/auth/callback
WORKOS_WEBHOOK_SECRET=

# Session cookie signing material (required in production).
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=accord_session

# development | staging | production
ENVIRONMENT=production

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://127.0.0.1:8082

# Public app URL for redirects/links (BASE_URL is accepted as an alias).
PUBLIC_APP_URL=http://127.0.0.1:8082
BASE_URL=http://127.0.0.1:8082

LOG_LEVEL=INFO

# Must be false in production (ADR 0003 fails closed).
DEV_AUTH_BYPASS=false

DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=60000

# --- Object storage (ADR 0010; MinIO locally) --------------------------------

# S3-compatible endpoint. Inside compose, api/worker should use http://minio:9000.
OBJECT_STORAGE_ENDPOINT=http://minio:9000

# Private bucket; opaque keys {organization_id}/{object_uuid}.
# minio-init creates this bucket idempotently (default: accord-artifacts).
OBJECT_STORAGE_BUCKET=accord-artifacts

# MinIO root credentials locally; use IAM keys in cloud.
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
