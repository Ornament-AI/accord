# syntax=docker/dockerfile:1
# Accord web image: multi-stage pnpm frontend build → nginx static + API proxy.
# No Firebase build args. No shared/ COPY — Accord has no shared/ package
# No shared/ fixture tree is copied into the image.

FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS builder

RUN corepack enable && corepack prepare pnpm@12.1.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/package.json

RUN pnpm install --frozen-lockfile \
    && (node node_modules/.pnpm/esbuild@*/node_modules/esbuild/install.js 2>/dev/null || true)

COPY frontend/ frontend/

WORKDIR /app/frontend

RUN pnpm build

FROM nginx:1.30.7-alpine@sha256:b24de00298eb7fb23839442d46c780991be7bc7ddb081b6c0876ac777012e352

COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
