# syntax=docker/dockerfile:1
# Accord web image: multi-stage pnpm frontend build → nginx static + API proxy.
# No Firebase build args. No shared/ COPY — Accord has no shared/ package
# No shared/ fixture tree is copied into the image.

FROM node:24.18.0-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.34.3 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/package.json

RUN pnpm install --frozen-lockfile \
    && (node node_modules/.pnpm/esbuild@*/node_modules/esbuild/install.js 2>/dev/null || true)

COPY frontend/ frontend/

WORKDIR /app/frontend

RUN pnpm build

FROM nginx:1.30-alpine

COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
